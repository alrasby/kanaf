<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- AV core: broad installed-package inventory. Requires Google Play
         sensitive-permission declaration and review before store publishing. -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />
    <!-- AV core: one-time user-approved shared-files access on Android 11+.
         Does NOT grant access to /data or Android/data protected directories. -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- Advanced opt-in: may be granted once via external ADB only. No runtime dialog. -->
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS"
        tools:ignore="ProtectedPermissions" />
    <!-- Scoped to launchable apps; no broad package visibility permission. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>
    <application android:icon="@drawable/kanaf_launcher_legacy" android:roundIcon="@mipmap/ic_launcher" android:label="Kanaf" android:theme="@android:style/Theme.Material.Light.NoActionBar" android:usesCleartextTraffic="false">
        <activity android:name=".MainActivity" android:exported="true" android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <data android:mimeType="text/plain"/>
            </intent-filter>
        </activity>
        <!-- Opt-in best-effort package event prompt; not a persistent realtime scanner.
             Protected Android package broadcasts; unavailable/hidden apps are not scanned. -->
        <receiver android:name=".engine.PackageChangeReceiver" android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.PACKAGE_ADDED" />
                <action android:name="android.intent.action.PACKAGE_REPLACED" />
                <data android:scheme="package" />
            </intent-filter>
        </receiver>
        <!-- Explicit user-approved DNS-only VPN; never activated automatically.
             Only one VPN can run on Android. Production Play/VpnService review required. -->
        <service android:name=".engine.KanafDnsVpnService"
            android:permission="android.permission.BIND_VPN_SERVICE"
            android:exported="true" android:foregroundServiceType="specialUse">
            <intent-filter>
                <action android:name="android.net.VpnService"/>
            </intent-filter>
            <property android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="User-initiated limited DNS ad and tracking domain filtering"/>
        </service>
        <!-- Quick Settings user-controlled VPN toggle with optional external ADB grant. -->
        <service android:name=".engine.KanafDnsTileService"
            android:exported="true"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE"
            android:icon="@drawable/kanaf_launcher_monochrome"
            android:label="Kanaf DNS">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE"/>
            </intent-filter>
        </service>
        <activity android:name=".engine.DnsSettingsShortcutActivity"
            android:exported="false"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />
        <activity android:name=".engine.DnsTileControlActivity"
            android:exported="false"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />
        <!-- Crash containment only: separate process, same app UID. Not an isolated UID. -->
        <service android:name=".engine.NativeScannerService"
            android:process=":scanner" android:exported="false" />
    </application>
</manifest>
