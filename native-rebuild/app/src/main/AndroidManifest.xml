<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- AV core: broad installed-package inventory. Requires Google Play
         sensitive-permission declaration and review before store publishing. -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />
    <!-- AV core: one-time user-approved shared-files access on Android 11+.
         Does NOT grant access to /data or Android/data protected directories. -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- Scoped to launchable apps; no broad package visibility permission. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>
    <application android:name=".KanafApplication" android:icon="@drawable/kanaf_launcher_legacy" android:roundIcon="@mipmap/ic_launcher" android:label="${kanafAppLabel}" android:theme="@style/KanafTheme" android:usesCleartextTraffic="false"
        android:allowBackup="false" android:fullBackupContent="false">
        <activity android:name=".MainActivity" android:exported="true" android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <data android:mimeType="*/*"/>
            </intent-filter>
        </activity>
        <!-- Package events are dynamically registered by KanafApplication.
             Android 8+ suppresses these implicit broadcasts in manifest receivers;
             an opt-in WorkManager delta inventory covers background process death. -->
        <!-- Explicit user-approved DNS-only VPN; never activated automatically.
             Only one VPN can run on Android. Production Play/VpnService review required. -->
        <service android:name=".engine.KanafDnsVpnService"
            android:permission="android.permission.BIND_VPN_SERVICE"
            android:exported="true" android:foregroundServiceType="specialUse">
            <intent-filter>
                <action android:name="android.net.VpnService"/>
            </intent-filter>
            <property android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="${kanafDnsServicePurpose}"/>
        </service>
        <!-- Quick Settings DNS-only VPN toggle, no elevated Android permissions. -->
        <service android:name=".engine.KanafDnsTileService"
            android:exported="true"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE"
            android:icon="@drawable/kanaf_status_icon"
            android:label="Kanaf DNS">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE"/>
            </intent-filter>
        </service>
        <activity android:name=".engine.DnsSettingsShortcutActivity"
            android:exported="false"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />
        <activity android:name=".engine.DnsTileControlActivity"
            android:exported="false"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />
        <!-- Crash containment only: separate process, same app UID. Not an isolated UID. -->
        <service android:name=".engine.NativeScannerService"
            android:process=":scanner" android:exported="false" />
    </application>
</manifest>
